# The efficios dependencies CI builds from source into ~/efficios_dep.
#
# The cache holding those builds is keyed on a hash of this file, so it is
# discarded when a dependency changes here and kept for every other edit to
# the setup action.
URCU_REF=v0.15.3
LTTNG_UST_REF=v2.14.0
LTTNG_TOOLS_REF=anl-v2.14.0
BABELTRACE_REF=anl-ms3

# The two refs above are branches rather than tags, so their name does not
# identify a build. These commits are unused by the build; they are here so
# that the cache key moves when a branch does. Update one after pushing to it.
LTTNG_TOOLS_CACHE_COMMIT=c3e62af6473ed223eedd59a761379736e6941b9d
BABELTRACE_CACHE_COMMIT=97c5d4205d1e3f18dd051bf5c5f4b49c18b1f193
